@@ -2007,7 +2007,7 @@ public class ServerGamePacketListenerImpl
                         }
 
                         PiercingWeapon piercingWeapon = itemInHand.get(DataComponents.PIERCING_WEAPON);
-                        if (piercingWeapon != null) {
+                        if (piercingWeapon != null && this.player.gameMode() != net.minecraft.world.level.GameType.SPECTATOR) { // Leaves - fix piercing weapon can attack in spectator mode
                             piercingWeapon.attack(this.player, EquipmentSlot.MAINHAND);
                         }
 
